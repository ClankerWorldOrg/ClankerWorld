<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The Windows package bundles a self-contained win-x64 host (scripts/package-windows.sh). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClankerWorld.Tests" />
    <Compile Include="../ClankerWorld.Shared/Contracts/**/*.cs" Exclude="../ClankerWorld.Shared/Contracts/NeedStates.cs;../ClankerWorld.Shared/Contracts/CalendarRules.cs" Link="Shared/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ClankerWorld.Shared/BuildInformation.cs" Link="Shared/BuildInformation.cs" />
    <ProjectReference Include="..\ClankerWorld.Simulation\ClankerWorld.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.55.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../ClankerWorld.Shared/EventVocabulary.cs" Link="Shared/EventVocabulary.cs" />
  </ItemGroup>
</Project>
