<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <RootNamespace>ClankerWorld.GodotClient</RootNamespace>
    <!-- The authoritative projects stay on the repository-wide .NET 10 target.
         Godot desktop projects retain this .NET 8 script target. -->
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ClankerWorld.Shared/Contracts/**/*.cs" Link="Shared/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../ClankerWorld.Shared/BuildInformation.cs" Link="Shared/BuildInformation.cs" />
    <Compile Include="../ClankerWorld.Shared/AgentPlacementRules.cs" Link="Shared/AgentPlacementRules.cs" />
    <Compile Include="../ClankerWorld.Shared/BoundedText.cs" Link="Shared/BoundedText.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../ClankerWorld.Shared/EventVocabulary.cs" Link="Shared/EventVocabulary.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../ClankerWorld.Shared/WorldEvents/*.cs" Link="Shared/WorldEvents/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
