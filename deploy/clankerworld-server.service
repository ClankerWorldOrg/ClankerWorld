[Unit]
Description=ClankerWorld world server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clanker
Group=clanker
# Fresh pre-release installation. The previous world and pairing authority
# remain in an operator backup; provider credentials can be copied separately.
WorkingDirectory=/opt/clankerworld-server
EnvironmentFile=-/etc/clankerworld-server/provider.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ClankerWorld__World__Mode=game
Environment=ClankerWorld__Clock__Run=true
Environment=ClankerWorld__Clock__ClientPresenceTimeoutSeconds=5
Environment=ClankerWorld__Http__Port=5188
Environment=ClankerWorld__Pairing__ApprovalPort=5189
Environment=ClankerWorld__Pairing__AuthorityPath=/var/lib/clankerworld-server/private-owner-authority.json
Environment=ClankerWorld__World__SavePath=/var/lib/clankerworld-server/world.json
Environment=ClankerWorld__Providers__ConfigurationPath=/var/lib/clankerworld-server/provider-configuration.json
Environment=ClankerWorld__Assets__CatalogPath=/etc/clankerworld-server/approved-assets.json
Environment=DOTNET_NOLOGO=1
StateDirectory=clankerworld-server
ExecStart=/home/clanker/.local/bin/dotnet /opt/clankerworld-server/ClankerWorld.Server.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
