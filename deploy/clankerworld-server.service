[Unit]
Description=ClankerWorld world host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clanker
Group=clanker
# Fresh pre-release installation. The previous world and pairing authority
# remain in an operator backup; provider credentials can be copied separately.
WorkingDirectory=/opt/clankerworld-server
EnvironmentFile=-/etc/clankerworld-server/provider.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ClankerWorld__Runtime__WorldMode=game
Environment=ClankerWorld__Runtime__AdvanceScript=true
Environment=ClankerWorld__Runtime__ClientPresenceTimeoutSeconds=5
Environment=ClankerWorld__Http__Port=5188
Environment=ClankerWorld__Pairing__LocalApprovalPort=5189
Environment=ClankerWorld__Pairing__StatePath=/var/lib/clankerworld-server/private-owner-authority.json
Environment=ClankerWorld__Runtime__StatePath=/var/lib/clankerworld-server/world.json
Environment=ClankerWorld__Runtime__ProviderStatePath=/var/lib/clankerworld-server/provider-configuration.json
Environment=ClankerWorld__Runtime__LegacyStatePath=/var/lib/clankerworld-server/phase-two-runtime.json
Environment=ClankerWorld__Assets__CatalogPath=/etc/clankerworld-server/approved-assets.json
Environment=DOTNET_NOLOGO=1
StateDirectory=clankerworld-server
ExecStart=/home/clanker/.local/bin/dotnet /opt/clankerworld-server/ClankerWorld.Server.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
